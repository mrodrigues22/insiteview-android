<?xml version="1.0" encoding="utf-8"?>
<!-- Android-only strings of the app module (no iOS catalog key, or the iOS text names iOS).
     Strings shared with iOS are in :features (com.getinsiteview.features.R). Keep the three locales in step. -->
<resources>
    <!-- Sign-in sheet: Apple through the web sign-in (iOS shows Apple's native "Continue with Apple" button). -->
    <string name="app_continue_with_apple">Continue with Apple</string>
    <!-- Sign-in sheet subtitle (save building). iOS says "on any iPhone". -->
    <string name="app_a_free_account_keeps_your_buildings_on_any_phone">A free account keeps your buildings in one place, on any phone.</string>
    <!-- Search tab: nothing found (iOS ContentUnavailableView.search). Placeholder: the query. -->
    <string name="app_no_results_for_x">No results for “%s”</string>
    <!-- Search tab: below "No results" (iOS ContentUnavailableView.search). -->
    <string name="app_check_the_spelling_or_try_a_new_search">Check the spelling or try a new search.</string>
    <!-- QR scanner without camera permission: opens the app's system settings. -->
    <string name="app_open_settings_android">Open settings</string>
    <!-- Search tab: clears the search box (accessibility label). -->
    <string name="app_clear_search">Clear search</string>
    <!-- Email sign-in: back to the sign-in options (accessibility label). -->
    <string name="app_back">Back</string>
</resources>
