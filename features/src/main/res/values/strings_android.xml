<?xml version="1.0" encoding="utf-8"?>
<!-- Android-only strings (not in the iOS String Catalog). scripts/xcstrings-to-android.py never touches this file. -->
<resources>
    <!-- Top bar back button (content description). -->
    <string name="back">Back</string>
    <!-- Guest landing: save section body (iOS says "on any iPhone"). -->
    <string name="save_it_to_a_free_account_on_any_phone">Save it to a free account to find it again in Buildings, on any phone.</string>
    <!-- AR coaching line, plates, alignment lost (iOS says "your iPhone"). -->
    <string name="alignment_lost_point_at_a_plate_again_or_move_slowly_so_your_phone">Alignment lost. Point at a plate again, or move slowly so your phone finds its place.</string>
    <!-- AR coaching line, placed by hand, alignment lost (iOS says "your iPhone"). -->
    <string name="alignment_lost_move_slowly_so_your_phone_finds_its_place_or">Alignment lost. Move slowly so your phone finds its place, or place the model again.</string>
    <!-- AR coaching line, placing by hand before the floor is found (iOS says "your iPhone"). -->
    <string name="move_your_phone_slowly_to_find_the_floor">Move your phone slowly to find the floor.</string>
    <!-- AR camera permission: restricted by policy (iOS says "this iPhone"). -->
    <string name="the_camera_is_restricted_on_this_phone_you_can_still_explore">The camera is restricted on this phone. You can still explore the model in 3D.</string>
    <!-- AR: ARCore missing or too old on a phone that supports it. Title. -->
    <string name="get_google_play_services_for_ar">Get Google Play Services for AR</string>
    <!-- AR: ARCore missing or too old. Message under the title. -->
    <string name="insite_view_needs_google_play_services_for_ar">Insite View needs Google Play Services for AR to show the model in your room. It\'s free on Google Play.</string>
    <!-- AR: installing ARCore was declined or failed. -->
    <string name="google_play_services_for_ar_couldn_t_be_installed">Google Play Services for AR couldn\'t be installed. Try again, or explore the model in 3D.</string>
    <!-- AR: button that installs Google Play Services for AR. -->
    <string name="install">Install</string>
    <!-- AR: the phone doesn't support ARCore. Title. -->
    <string name="ar_isn_t_available_on_this_phone">AR isn\'t available on this phone</string>
    <!-- AR: the phone doesn't support ARCore. Message. -->
    <string name="this_phone_can_t_show_the_model_in_your_room">This phone can\'t show the model in your room. You can still explore it in 3D.</string>
    <!-- AR: the ARCore session failed to start (camera in use, ARCore error). -->
    <string name="ar_couldn_t_start_try_again_or_explore_the_model_in_3d">AR couldn\'t start. Try again, or explore the model in 3D.</string>
</resources>
